# Example environment variables for contained_registration
# Copy this file to .env and fill in your values
# Note: The standalone register_project_key.py works without any env vars
# These are only needed if you want to use S3 sync features

# AWS credentials (optional - only needed for S3 checkpoint syncing)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-bucket-name
