# LLM providers — add keys for the providers you use
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Academic search (optional — unauthenticated access is rate-limited)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# ACS agent only
CENSUS_API_KEY=your_census_api_key_here

# Data root — required; set to the directory where your datasets live
DATA_PATH=/path/to/your/data

# Census agent — requires the external acs_agent package to be installed
# Set to true on systems where `pip install -e /path/to/acs_agent` has been run.
# CENSUS_AGENT_AVAILABLE=true

# OpenTargets agent — requires /oak/ data access (HPC only)
# Set to true on systems where the OpenTargets parquet data and MCP package are accessible.
# OPENTARGETS_AGENT_AVAILABLE=true

# Claude Code paths — auto-detected after `npm install`; only set if non-standard
# CLAUDE_CODE_CLI_PATH=/path/to/node_modules/@anthropic-ai/claude-code/cli.js
# NODE_PATH=/path/to/node_modules
